<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_gradient_bg">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="TIPO DE CARRO"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Área 3D -->
    <FrameLayout
        android:id="@+id/threeContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardEquipamentos">

        <WebView
            android:id="@+id/web3d"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:overScrollMode="never" />
    </FrameLayout>

    <!-- Card inferior com os equipamentos -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEquipamentos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Equipamentos"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarProjeto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Salvar Projeto"
                app:cornerRadius="15dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmplificador"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Amplificador"
                android:textAllCaps="false"
                android:textColor="#1F2937"
                android:background="@drawable/menu_button_light"
                app:icon="@drawable/icon_amp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                android:layout_marginTop="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAltoFalante"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Alto-falante"
                android:textAllCaps="false"
                android:textColor="#1F2937"
                android:background="@drawable/menu_button_light"
                app:icon="@drawable/icon_alto"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                android:layout_marginTop="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubwoofer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Subwoofer"
                android:textAllCaps="false"
                android:textColor="#1F2937"
                android:background="@drawable/menu_button_light"
                app:icon="@drawable/icon_sub"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                android:layout_marginTop="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrossover"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Crossovers"
                android:textAllCaps="false"
                android:textColor="#1F2937"
                android:background="@drawable/menu_button_light"
                app:icon="@drawable/icon_cross"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Loader central branco (fica sobre tudo) -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:contentDescription="Carregando…"
        android:indeterminateTint="@android:color/white"
        android:indeterminateTintMode="src_in"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
